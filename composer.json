  "authors": [
    {
      "name": "Nowgate",
      "homepage": "https://nowgate.io"
    }
  ],
  "support": {
    "docs": "https://docs.nowgate.io/sdks/php",
    "source": "https://github.com/Nowgate/nowgate-php",
    "issues": "https://github.com/Nowgate/nowgate-php/issues"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Nowgate\\": "src/"
    }
  }
